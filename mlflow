import numpy as np
import pandas as pd

def load_data():
    np.random.seed(42)
    n = 300

    area = np.random.randint(600, 3000, n)
    bedrooms = np.random.randint(1, 6, n)
    age = np.random.randint(0, 40, n)

    price = (
        1500 * area
        + 300000 * bedrooms
        - 20000 * age
        + np.random.normal(0, 150000, n)
    )

    df = pd.DataFrame({
        "area": area,
        "bedrooms": bedrooms,
        "age": age,
        "price": price
    })

    return df
